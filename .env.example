#Example ENV file. Rename to .env and fill in your values.

#JIRA
JIRA_BASE_URL="https://<emailaddress>.atlassian.net"
JIRA_EMAIL="<emailaddress>"
JIRA_API_TOKEN="<JIRA API TOKEN>"  #https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY="KAN"

#OPENAI
OPENAI_API_KEY="<OPENAI TOKEN>" #https://platform.openai.com
OPENAI_MODEL="gpt-4o-mini"
AI_PROMPT="
You are a precise project manager. Produce a crisp weekly status report from the task list.
    Return exactly three sections with short bullet points:
    1) Overall Status
    2) Key Risks & Blockers
    3) Next Steps
    Be concrete; name specific tasks/owners; highlight overdue/unassigned items; avoid fluff.
    If tasks are empty, state likely reasons and propose next steps.
"

#GENERIC
REPORT_OUTPUT="weekly_report.txt"
LOG_LEVEL=INFO #Can be DEBUG, WARNING, ERROR