# Copy this file to .env and replace every placeholder.

#JIRA
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="replace-me"
JIRA_PROJECT_KEY="ABC"

#OPENAI
OPENAI_API_KEY="replace-me"
OPENAI_MODEL="gpt-4o-mini"
AI_PROMPT="
You are a precise project manager. Produce a crisp weekly status report from the task list.
    Return exactly three sections with short bullet points:
    1) Overall Status
    2) Key Risks & Blockers
    3) Next Steps
    Be concrete; name specific tasks/owners; highlight overdue/unassigned items; avoid fluff.
    If tasks are empty, state likely reasons and propose next steps.
"

#GENERIC
REPORT_OUTPUT="weekly_report.txt"
LOG_LEVEL=INFO
